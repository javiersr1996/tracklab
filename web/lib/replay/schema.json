{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracklab.dev/replay/possession.schema.json",
  "title": "Track Lab replay possession",
  "description": "One curated possession (task 17 of tasks/todo.md), as written by `tracklab publish possessions` from silver. Strict on purpose: an unknown field or a value outside its enum is a publishing bug, not a shape the player has to tolerate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "possession_id",
    "sport",
    "match",
    "surface",
    "clock_kind",
    "sample_rate_hz",
    "team_in_possession",
    "attack_sign",
    "entities",
    "frames"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "possession_id": { "type": "string", "minLength": 1 },
    "sport": { "enum": ["basketball", "football"] },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match_id", "home", "away", "kickoff_utc"],
      "properties": {
        "match_id": { "type": "string", "minLength": 1 },
        "home": { "type": "string", "minLength": 1 },
        "away": { "type": "string", "minLength": 1 },
        "kickoff_utc": { "type": "string", "format": "date-time" }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "length_m", "width_m"],
      "properties": {
        "spec": { "type": "string", "minLength": 1 },
        "length_m": { "type": "number", "exclusiveMinimum": 0 },
        "width_m": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "clock_kind": { "enum": ["countdown", "elapsed"] },
    "sample_rate_hz": { "type": "integer", "exclusiveMinimum": 0 },
    "team_in_possession": { "type": "string", "minLength": 1 },
    "attack_sign": { "enum": [1, -1] },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["i", "entity_id", "kind", "team_id", "jersey", "name"],
        "properties": {
          "i": { "type": "integer", "minimum": 0 },
          "entity_id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["player", "ball"] },
          "team_id": { "type": ["string", "null"] },
          "jersey": { "type": ["string", "null"] },
          "name": { "type": ["string", "null"] }
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t", "clock", "o"],
        "properties": {
          "t": { "type": "integer", "minimum": 0 },
          "clock": { "type": "number" },
          "o": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                { "type": "integer", "minimum": 0 },
                { "type": "number" },
                { "type": "number" },
                { "type": ["number", "null"] },
                { "enum": [0, 1] }
              ],
              "items": false,
              "minItems": 5,
              "maxItems": 5
            }
          }
        }
      }
    }
  }
}
