    },
    {
      "key": "seed_surface_spec",
      "group": "silver",
      "kind": "asset",
      "description": "The surface specs a match can be played on, with their dimensions in metres. Two rows: the FIBA court task 9 measured, and the NBA court it rejected, kept so the rejection stays visible instead of disappearing into a WHERE clause. Football does not appear here because its pitch is declared per match by the provider.\n",
      "step": "silver",
      "sport": null,
      "schema": "dbt",
      "dbt_tests": 4,
      "dbt_columns": [
        "length_m",
        "surface_spec",
        "width_m"
      ]
    },
