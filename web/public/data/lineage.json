      "description": "One row per match and period. Football declares its boundaries in match.json; basketball's are read off the tracking, which is the only place its period changes.\n",
      "step": "silver",
      "sport": null,
      "schema": "dbt",
      "dbt_tests": 10,
      "dbt_columns": [
        "frame_native_end",
        "frame_native_start",
        "match_id",
        "period",
        "regulation_s",
        "t_ms_end",
        "t_ms_start"
      ]
    },
    {
      "key": "silver_dim_sport",
      "group": "silver",
      "kind": "asset",
      "description": "The two rows that turn `sport` into a column. Every constant of a bundle that silver needs lives here once: the unit and its factor to metres, the sample rate, the semantics of the official clock, how many players are on the surface and which frame the provider's events arrive in.\n",
      "step": "silver",
      "sport": null,
      "schema": "dbt",
      "dbt_tests": 14,
      "dbt_columns": [
        "clock_kind",
        "id_prefix",
        "native_event_frame",
        "players_on_surface",
        "sample_rate_hz",
        "sport",
        "unit_to_m"
      ]
    },
    {
      "key": "silver_dim_team",
      "group": "silver",
      "kind": "asset",
      "description": "One row per team, 30 in total (17 basketball, 13 football).",
      "step": "silver",
      "sport": null,
      "schema": "dbt",
      "dbt_tests": 6,
      "dbt_columns": [
        "name",
        "native_team_id",
        "sport",
        "team_id"
      ]
    },
    {
      "key": "silver_dim_team_period",
      "group": "silver",
      "kind": "asset",
      "description": "Task 9 in silver keys: which way each team attacks in each period, and the evidence that fixed it. Two rows per (match, period), opposite signs, asserted by tests/assert_attack_signs_opposite.sql.\n",
      "step": "silver",
      "sport": null,
      "schema": "dbt",
      "dbt_tests": 10,
      "dbt_columns": [
        "attack_sign",
        "evidence",
        "match_id",
        "period",
        "team_id"
      ]
    },
    {
      "key": "silver_events",
      "group": "silver",
      "kind": "asset",
      "description": "Every event of both bundles in one shape: 20 native families in basketball, 4 plus the phases of play in football, and the football team possession this project derives. Coordinates are rotated to the venue frame, and a row whose rotation cannot be resolved carries none.\n",
      "step": "silver",
      "sport": null,
      "schema": "dbt",
      "dbt_tests": 14,
      "dbt_columns": [
        "event_id",
        "event_type",
        "match_id",
        "native_family",
        "period",
        "possession_id",
        "sport",
        "team_id"
      ]
    },
    {
      "key": "silver_frame_possession",
      "group": "silver",
      "kind": "asset",
      "description": "Which team possession a frame belongs to. A view, because expanding the possessions to their frames would write tens of millions of rows that are one range join away from what silver already holds.\n",
      "step": "silver",
      "sport": null,
      "schema": "dbt",
      "dbt_tests": 7,
      "dbt_columns": [
        "frame_native",
        "match_id",
        "possession_id",
        "team_id"
      ]
    },
    {
      "key": "silver_frames",
      "group": "silver",
      "kind": "asset",
      "description": "The physical record of both sports in one shape: one row per match, native frame and entity, in metres and in the venue frame. Built from the tracking and from nothing else. Partitioned on disk by sport and native match id, because a silver match_id carries a colon and that is not a directory name on Windows.\n",
      "step": "silver",
      "sport": null,
      "schema": "dbt",
      "dbt_tests": 20,
      "dbt_columns": [
        "clock_s",
        "entity_id",
        "entity_kind",
        "frame_native",
        "is_detected",
        "match_id",
        "native_match_id",
        "period",
        "sport",
        "t_ms",
        "team_id",
        "x_m",
        "y_m",
        "z_m"
      ]
    },
    {
      "key": "silver_frames_attacking",
      "group": "silver",
      "kind": "asset",
      "description": "The frames of a team possession, turned so the team with the ball attacks towards +x: x_att_m = attack_sign * x_m. The only attack normalisation in silver. A frame no possession claims is absent, never given a guessed sign.\n",
      "step": "silver",
      "sport": null,
      "schema": "dbt",
      "dbt_tests": 2,
      "dbt_columns": [
        "attack_sign"
      ]
    }
